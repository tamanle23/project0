# Facebook App Credentials for App Integrations
# 1. Meta App ID (safe for frontend, used in FB.init)
VITE_FACEBOOK_APP_ID=
# 2. Meta App Secret (used client-side for long-lived token exchange)
# Note: In production public apps, keep App Secret on the backend server.
VITE_FACEBOOK_APP_SECRET=

# YouTube / Google OAuth 2.0 Credentials for App Integrations
# 1. Google OAuth Client ID (safe for frontend, used in OAuth authorization URL)
VITE_YOUTUBE_CLIENT_ID=
# 2. Google OAuth Client Secret (used for authorization code exchange & refresh token)
# Note: In production public apps, keep Client Secret on the backend server.
VITE_YOUTUBE_CLIENT_SECRET=

# TikTok OAuth 2.0 Credentials for App Integrations
# 1. TikTok Client Key (safe for frontend, used in OAuth authorization URL)
VITE_TIKTOK_CLIENT_KEY=
# 2. TikTok Client Secret (used for authorization code exchange & refresh token)
# Note: In production public apps, keep Client Secret on the backend server.
VITE_TIKTOK_CLIENT_SECRET=

# Router History Strategy Configuration
# VITE_ROUTER_MODE: 'browser' | 'hash' | 'memory' | 'auto' (default: 'auto')
# 'browser' = HTML5 pushState URL routing (Web default)
# 'hash' = Hash URL routing /#/path (Desktop default)
# 'memory' = In-memory history without modifying URL
VITE_ROUTER_MODE=auto

# Optional Desktop Router History mode override when VITE_ROUTER_MODE is 'auto'
# VITE_DESKTOP_ROUTER_MODE: 'hash' | 'browser' | 'memory' (default: 'hash')
VITE_DESKTOP_ROUTER_MODE=hash
