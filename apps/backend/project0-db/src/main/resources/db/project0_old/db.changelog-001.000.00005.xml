<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet id="changelog-001.000.00005" author="Le Tam An" runInTransaction="true" onValidationFail="MARK_RAN">
    <createTable tableName="project">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_project_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_project_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>
    </createTable>
    <createTable tableName="article_tag">
      <column name="owner_id" type="BIGINT" />
      <column name="tag" type="VARCHAR(100)"></column>
    </createTable>
    <createTable tableName="article">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_article_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_article_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>
      <column name="project_id" type="BIGINT">
        <constraints foreignKeyName="FK_article_projectid_project"
          referencedTableName="project" referencedColumnNames="id" />
      </column>
      <column name="header" type="VARCHAR(500)"></column>
      <column name="content" type="CLOB"></column>
    </createTable>
  </changeSet>
</databaseChangeLog> 