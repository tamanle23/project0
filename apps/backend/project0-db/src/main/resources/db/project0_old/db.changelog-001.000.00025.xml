<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet id="changelog-001.000.00025" author="Le Tam An" runInTransaction="true" onValidationFail="MARK_RAN">
    <createTable tableName="task">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="description" type="VARCHAR(200)"></column>
      <column name="createdBy_uid" type="VARCHAR(50)"></column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_uid" type="VARCHAR(50)"></column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>
      <column name="frequency" type="VARCHAR(50)"></column>
      <column name="type" type="VARCHAR(50)"></column>
      <column name="triggerType" type="VARCHAR(50)"></column>
      <column name="runAfter" type="TIMESTAMP"></column>
      <column name="cronExpression" type="VARCHAR(100)"></column>
      <column name="reference" type="VARCHAR(50)"></column>
      <column name="status" type="VARCHAR(50)"></column>
    </createTable>
  </changeSet>
</databaseChangeLog> 