<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
  <changeSet author="tamanle23" id="changelog-${schema}-000.000.00000">
    <createTable tableName="${table_prefix}TASK">
      <column autoIncrement="true" name="ID" type="INT">
        <constraints primaryKey="true" primaryKeyName="PK_TASK"/>
      </column>
      <column name="UID" type="VARCHAR(50)"/>
      <column name="CODE" type="VARCHAR(50)"/>
      <column name="DESCRIPTION" type="VARCHAR(200)"/>
      <column name="CREATEDBY_UID" type="VARCHAR(50)"/>
      <column name="CREATEDDATE" type="TIMESTAMP"/>
      <column name="LASTUPDATEDBY_UID" type="VARCHAR(50)"/>
      <column name="LASTUPDATEDDATE" type="TIMESTAMP"/>
      <column name="VERSION" type="INT"/>
      <column name="DELETEDDATE" type="TIMESTAMP"/>
      <column name="MODE" type="VARCHAR(50)"/>
      <column name="FREQUENCY" type="VARCHAR(50)"/>
      <column name="TYPE" type="VARCHAR(50)"/>
      <column name="TRIGGERTYPE" type="VARCHAR(50)"/>
      <column name="RUNAFTER" type="TIMESTAMP"/>
      <column name="CRONEXPRESSION" type="VARCHAR(100)"/>
      <column name="REFERENCE" type="VARCHAR(50)"/>
      <column name="STATUS" type="VARCHAR(50)"/>
      <column name="OWNER_UID" type="VARCHAR(50)"/>
      <column name="STATE" type="VARCHAR(20)"/>
    </createTable>
    <createIndex tableName="${table_prefix}TASK" indexName="IDX_${table_prefix}TASK_CODE">
      <column name="code" />
    </createIndex>
    <addUniqueConstraint columnNames="UID" constraintName="UN_10383" tableName="${table_prefix}TASK"/>
  </changeSet>
</databaseChangeLog>
