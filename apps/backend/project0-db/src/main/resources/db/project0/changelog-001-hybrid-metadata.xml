            <column name="createdDate" type="TIMESTAMP(3)"/>
            <column name="lastUpdatedBy_uid" type="VARCHAR(255)"/>
            <column name="lastUpdatedDate" type="TIMESTAMP(3)"/>
            <column name="version" type="BIGINT"/>
            <column name="deletedDate" type="TIMESTAMP(3)"/>
            <column name="mode" type="VARCHAR(50)"/>
            <column name="state" type="VARCHAR(20)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="PROJECT0_ATTRIBUTE_DEFINITIONS" baseColumnNames="entity_type_id" constraintName="fk_attr_def_entity_type" referencedTableName="PROJECT0_ENTITY_TYPES" referencedColumnNames="id"/>

        <createTable tableName="PROJECT0_ENTITIES">
            <column name="id" type="BIGINT" autoIncrement="true">
