<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
  <changeSet author="tamanle23" id="changelog-${schema}-000.000.00000">
    <createTable tableName="${table_prefix}MESSAGE">
      <column autoIncrement="true" name="ID" type="INT">
        <constraints primaryKey="true" primaryKeyName="PK_MESSAGE"/>
      </column>
      <column name="MESSAGEKEY" type="VARCHAR(50)"/>
      <column name="LANGUAGE" type="VARCHAR(10)"/>
      <column name="COUNTRY" type="VARCHAR(10)"/>
      <column name="BASENAME" type="VARCHAR(50)"/>
      <column name="VARIANT" type="VARCHAR(50)"/>
      <column name="MESSAGE" type="VARCHAR(200)"/>
    </createTable>
    <createTable tableName="${table_prefix}RESOURCE">
      <column autoIncrement="true" name="ID" type="INT">
        <constraints primaryKey="true" primaryKeyName="PK_RESOURCE"/>
      </column>
      <column name="RESOURCEKEY" type="VARCHAR(100)"/>
      <column name="MESSAGEKEY" type="VARCHAR(100)"/>
      <column name="VALUE" type="VARCHAR(200)"/>
      <column name="VALUE2" type="VARCHAR(200)"/>
      <column name="VALUE3" type="VARCHAR(200)"/>
      <column name="CATEGORY" type="VARCHAR(50)"/>
      <column name="RESOURCEGROUP" type="VARCHAR(50)"/>
    </createTable>
  </changeSet>
</databaseChangeLog>
