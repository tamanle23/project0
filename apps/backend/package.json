{
  "name": "@project0/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Project0 Java Spring Modulith backend with project0-ms-aio wrapper application",
  "scripts": {
    "build": "node mvnw.cjs clean package -DskipTests",
    "dev": "node mvnw.cjs -pl project0-ms-aio spring-boot:run -Dspring-boot.run.profiles=dev",
