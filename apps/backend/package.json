{
  "name": "@unipost/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Unipost Java Spring Modulith backend with unipost-ms-aio wrapper application",
  "scripts": {
    "build": "node mvnw.cjs clean package -DskipTests",
    "dev": "node mvnw.cjs -pl unipost-ms-aio spring-boot:run -Dspring-boot.run.profiles=local",
    "test": "node mvnw.cjs test",
    "test:modulith": "node mvnw.cjs -pl unipost-ms-aio test -Dtest=ModularityTests",
    "lint": "node mvnw.cjs test-compile -DskipTests",
    "check-types": "node mvnw.cjs test-compile -DskipTests",
    "clean": "node mvnw.cjs clean",
    "db-migrate-local": "node mvnw.cjs -pl unipost-db spring-boot:run -Dspring-boot.run.profiles=local"
  }
}
