<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet id="changelog-001.000.00002" author="Le Tam An" failOnError="true">
    <createTable tableName="userRole">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_userRole_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_userRole_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>

      <column name="userName" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_userRole_userName_user"
          referencedTableName="user" referencedColumnNames="userName" />
      </column>
      <column name="roleCode" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_userRole_roleCode_role"
          referencedTableName="role" referencedColumnNames="code" />
      </column>
    </createTable>
    <rollback>
      <dropTable tableName="userRole" />
    </rollback>
  </changeSet>
</databaseChangeLog> 