<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet id="changelog-001.000.00022" author="Le Tam An" runInTransaction="true" onValidationFail="MARK_RAN">
    <addColumn tableName="fsObject">
      <column name="owner_uid" type="VARCHAR(50)"></column>
    </addColumn>
    <sql>
      UPDATE fsObject SET owner_uid = (SELECT uid FROM user WHERE id = owner_id);
    </sql>
    <dropForeignKeyConstraint baseTableName="fsObject" constraintName="FK_file_ownerid_user"/>
    <dropColumn tableName="fsObject" columnName="owner_id"></dropColumn>
  </changeSet>
</databaseChangeLog>
