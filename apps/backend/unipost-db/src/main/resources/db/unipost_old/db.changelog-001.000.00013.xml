<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet id="changelog-001.000.00013" author="Le Tam An" runInTransaction="true"  onValidationFail="MARK_RAN" >
    <addColumn tableName="permission">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="userRole">
      <column name="role_uid" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_userRole_roleUid_role"
                      referencedTableName="role" referencedColumnNames="uid" />
      </column>
    </addColumn>
    <addColumn tableName="userRole">
      <column name="user_uid" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_roleRole_userUid_user" 
                      referencedTableName="user" referencedColumnNames="uid" />
      </column>
    </addColumn>
    <addColumn tableName="rolePermission">
      <column name="role_uid" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_rolePermission_roleUid_role"
                      referencedTableName="role" referencedColumnNames="uid" />
      </column>
    </addColumn>
    <addColumn tableName="rolePermission">
      <column name="permission_uid" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_rolePermission_permissionUid_role" 
                      referencedTableName="permission" referencedColumnNames="uid" />
      </column>
    </addColumn>
    <addColumn tableName="userPermission">
      <column name="permission_uid" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_userPermission_roleUid_permission"
                      referencedTableName="permission" referencedColumnNames="uid" />
      </column>
    </addColumn>
    <addColumn tableName="userPermission">
      <column name="user_uid" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_userPermission_userUid_user" 
                      referencedTableName="user" referencedColumnNames="uid" />
      </column>
    </addColumn>
    <sql>
      UPDATE role SET uid = '407a738c1d6343c9bfe1b103e3b9d7bd' WHERE code='administrator';
      UPDATE user SET uid = '954931074bbd4541ac1f6a333489bb58' WHERE userName = 'administrator';
      UPDATE user SET uid = 'c3dd389ad34d49aeb6029a37b482df63' WHERE userName = 'admin';
      
      UPDATE userRole SET uid = 'be8f32350d9c4690b0949749c5402fbe', user_uid = '954931074bbd4541ac1f6a333489bb58', role_uid = '407a738c1d6343c9bfe1b103e3b9d7bd' WHERE userName = 'admin' AND roleCode = 'administrator';
      UPDATE userRole SET uid = '99696d7e86e54d5e9586a87b785eb8a4', user_uid = 'c3dd389ad34d49aeb6029a37b482df63', role_uid = '407a738c1d6343c9bfe1b103e3b9d7bd' WHERE userName = 'administrator' AND roleCode = 'administrator';
      UPDATE permission SET uid = 'acf76c092f57449881502d1234c80f0e' WHERE code = 'dashboard';
      UPDATE rolePermission SET uid = '7d0bdc89d6e04019ae36ad738f3bf372', permission_uid = 'acf76c092f57449881502d1234c80f0e', role_uid = '407a738c1d6343c9bfe1b103e3b9d7bd' WHERE roleCode = 'administrator' AND permissionCode = 'dashboard';
    
    </sql>
    <dropForeignKeyConstraint baseTableName="userRole" constraintName="FK_userRole_roleCode_role"/>
    <dropForeignKeyConstraint baseTableName="userRole" constraintName="FK_userRole_userName_user"/>
    <dropColumn tableName="userRole" columnName="roleCode"></dropColumn>
    <dropColumn tableName="userRole" columnName="userName"></dropColumn>
    <dropForeignKeyConstraint baseTableName="rolePermission" constraintName="FK_rolePermission_roleCode_role"/>
    <dropForeignKeyConstraint baseTableName="rolePermission" constraintName="FK_rolePermission_permissionCode_permission"/>
    <dropColumn tableName="rolePermission" columnName="roleCode"></dropColumn>
    <dropColumn tableName="rolePermission" columnName="permissionCode"></dropColumn>
    <dropForeignKeyConstraint baseTableName="userPermission" constraintName="FK_userPermission_userName_user"/>
    <dropForeignKeyConstraint baseTableName="userPermission" constraintName="FK_userPermission_permissionCode_permission"/>
    <dropColumn tableName="userPermission" columnName="userName"></dropColumn>
    <dropColumn tableName="userPermission" columnName="permissionCode"></dropColumn>
  </changeSet>
</databaseChangeLog> 