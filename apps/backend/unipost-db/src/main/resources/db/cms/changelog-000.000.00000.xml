<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
  <changeSet author="tamanle23" id="changelog-${schema}-000.000.00000">
    <createTable tableName="${table_prefix}ARTICLE">
      <column name="ID" type="INT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="PK_ARTICLE"/>
      </column>
      <column name="CODE" type="VARCHAR(50)"></column>
      <column name="CREATEDDATE" type="TIMESTAMP"/>
      <column name="LASTUPDATEDDATE" type="TIMESTAMP"/>
      <column name="VERSION" type="BIGINT"/>
      <column name="DELETEDDATE" type="TIMESTAMP"/>
      <column name="MODE" type="VARCHAR(50)"/>
      <column name="HEADER" type="VARCHAR(100)"/>
      <column name="SUMMARY" type="VARCHAR(500)"/>
      <column name="CONTENT" type="CLOB"/>
      <column name="CONTENTTYPE" type="TINYINT"/>
      <column name="COVERIMAGE" type="VARCHAR(50)"></column>
      <column name="UID" type="VARCHAR(50)"></column>
      <column name="DESCRIPTION" type="VARCHAR(200)"/>
      <column name="CREATEDBY_UID" type="VARCHAR(50)"/>
      <column name="LASTUPDATEDBY_UID" type="VARCHAR(50)"/>
      <column name="OWNER_UID" type="VARCHAR(50)"/>
    </createTable>
    <createTable tableName="${table_prefix}ARTICLETAG">
      <column name="ID" type="INT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="PK_ARTICLE_TAG"/>
      </column>
      <column name="OWNER_ID" type="BIGINT"/>
      <column name="TAG" type="VARCHAR(100)">
        <constraints uniqueConstraintName="UN_${table_prefix}_ARTICLE_TAG_TAG" referencedColumnNames="TAG"
                     unique="false"/>
      </column>
    </createTable>
    <createIndex tableName="${table_prefix}ARTICLE" indexName="IDX_${table_prefix}ARTICLE_CODE">
      <column name="code" />
    </createIndex>
    <addUniqueConstraint tableName="${table_prefix}ARTICLE" columnNames="uid" />
  </changeSet>
</databaseChangeLog>
