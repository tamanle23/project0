<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet id="changelog-001.000.00000" author="Le Tam An">
    <createTable tableName="user">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_user_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_user_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>

      <column name="userName" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="email" type="VARCHAR(200)"></column>
      <column name="password" type="VARCHAR(128)"></column>
      <column name="nonExpired" type="BOOLEAN"></column>
      <column name="nonLocked" type="BOOLEAN"></column>
      <column name="credentialsNonExpired" type="BOOLEAN"></column>
      <column name="status" type="TINYINT"></column>
      <column name="type" type="VARCHAR(50)"></column>
      <column name="approver_id" type="BIGINT">
        <constraints foreignKeyName="FK_user_approver_id_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
    </createTable>
    <createTable tableName="userActivity">
      <column name="discriminator" type="VARCHAR(31)"></column>
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="operationuser_id" type="BIGINT">
        <constraints foreignKeyName="FK_userActivity_operationuserid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="operationTime" type="TIMESTAMP"></column>
      <column name="authenticationType" type="TINYINT"></column>
      <column name="userAgent" type="VARCHAR(2000)"></column>
      <column name="description" type="VARCHAR(2000)"></column>
    </createTable>
    <createTable tableName="license">
      <column name="discriminator" type="VARCHAR(31)"></column>
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_license_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_license_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>

      <column name="fromDate" type="TIMESTAMP"></column>
      <column name="toDate" type="TIMESTAMP"></column>
      <column name="nonLocked" type="BOOLEAN"></column>
      <column name="user_id" type="BIGINT">
        <constraints foreignKeyName="FK_license_userid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="qrCode" type="BLOB"></column>
    </createTable>
    <createTable tableName="role">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_role_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_role_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>

    </createTable>
    <createTable tableName="permission">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_permission_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_permission_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>

    </createTable>
    <createTable tableName="userPermission">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_userPermission_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_userPermission_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>

      <column name="userName" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_userPermission_userName_user"
          referencedTableName="user" referencedColumnNames="userName" />
      </column>
      <column name="permissionCode" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_userPermission_permissionCode_permission"
          referencedTableName="permission" referencedColumnNames="code" />
      </column>
    </createTable>
    <createTable tableName="rolePermission">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_rolePermission_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_rolePermission_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>

      <column name="roleCode" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_rolePermission_roleCode_role"
          referencedTableName="role" referencedColumnNames="code" />
      </column>
      <column name="permissionCode" type="VARCHAR(50)">
        <constraints foreignKeyName="FK_rolePermission_permissionCode_permission"
          referencedTableName="permission" referencedColumnNames="code" />
      </column>
    </createTable>
    <createTable tableName="userProfile">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_userProfile_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_userProfile_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>

      <column name="dateFormat" type="VARCHAR(100)"></column>
      <column name="dateTimeFormat" type="VARCHAR(100)"></column>
      <column name="locale" type="VARCHAR(10)"></column>
      <column name="parent_id" type="BIGINT">
        <constraints foreignKeyName="FK_userProfile_parentid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
    </createTable>
    <createTable tableName="address">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_address_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_address_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>
      <column name="name" type="VARCHAR(50)"></column>
      <column name="country" type="VARCHAR(100)"></column>
      <column name="city" type="VARCHAR(200)"></column>
      <column name="state" type="VARCHAR(200)"></column>
      <column name="addressLine" type="VARCHAR(200)"></column>
      <column name="zipCode" type="VARCHAR(10)"></column>
    </createTable>
    <rollback>
      <dropTable tableName="user" />
      <dropTable tableName="userActivity" />
      <dropTable tableName="license" />
      <dropTable tableName="permission" />
      <dropTable tableName="role" />
      <dropTable tableName="userPermission" />
      <dropTable tableName="rolePermission" />
      <dropTable tableName="address" />
      <dropTable tableName="userProfile" />
    </rollback>
  </changeSet>
</databaseChangeLog> 