<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet id="changelog-001.000.00009" author="Le Tam An" runInTransaction="true">
    <createTable tableName="fileDirectory">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_fileDirectory_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_fileDirectory_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>
      <column name="project_id" type="BIGINT">
        <constraints foreignKeyName="FK_fileDirectory_projectid_project"
          referencedTableName="project" referencedColumnNames="id" />
      </column>
      <column name="parent_id" type="BIGINT">
        <constraints foreignKeyName="FK_fileDirectory_parentid_project"
          referencedTableName="fsObject" referencedColumnNames="id" />
      </column>
      <column name="child_id" type="BIGINT">
        <constraints foreignKeyName="FK_fileDirectory_childid_project"
          referencedTableName="fsObject" referencedColumnNames="id" />
      </column>
    </createTable>
    <addColumn tableName="user">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="userPermission">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="userProfile">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="userRole">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="address">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="article">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="fsObject">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="license">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="project">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="role">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
    <addColumn tableName="rolePermission">
      <column name="uid" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
    </addColumn>
  </changeSet>
</databaseChangeLog>
