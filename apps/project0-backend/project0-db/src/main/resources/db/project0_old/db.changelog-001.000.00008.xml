<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet id="changelog-001.000.00008" author="Le Tam An" runInTransaction="true">
    <createTable tableName="fsObject">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints unique="true" />
      </column>
      <column name="name" type="VARCHAR(255)"></column>
      <column name="createdBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_file_createdByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="createdDate" type="TIMESTAMP"></column>
      <column name="lastUpdatedBy_id" type="BIGINT">
        <constraints foreignKeyName="FK_file_lastUpdatedByid_user"
          referencedTableName="user" referencedColumnNames="id" />
      </column>
      <column name="lastUpdatedDate" type="TIMESTAMP"></column>
      <column name="version" type="BIGINT"></column>
      <column name="deletedDate" type="TIMESTAMP"></column>
      <column name="project_id" type="BIGINT">
        <constraints foreignKeyName="FK_file_projectid_project" referencedTableName="project" referencedColumnNames="id" />
      </column>
      <column name="extension" type="VARCHAR(50)"></column>
      <column name="isPersisted" type="BOOLEAN"></column>
      <column name="isDirectory" type="BOOLEAN"></column>
      <column name="contentType" type="VARCHAR(50)"></column>
      <column name="rootLocation" type="VARCHAR(300)"></column>
      <column name="size" type="BIGINT"></column>
      <column name="checksum" type="VARCHAR(64)"></column>
    </createTable>
  </changeSet>
</databaseChangeLog>
