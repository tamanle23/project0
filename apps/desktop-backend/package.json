{
  "name": "@project0/server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/bundle.js && node --build-sea sea-config.json",
    "make": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/bundle.js",
    "package": "node --build-sea sea-config.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@project0/typescript-config": "workspace:*",
    "@types/node": "^25.5.0",
    "tsx": "^4.7.1",
    "typescript": "^6.0.3"
  }
}
